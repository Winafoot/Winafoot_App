<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

  <!-- Aucun accès à la galerie (READ_MEDIA_IMAGES/VIDEO) : l'app ne lit aucun média de l'appareil. -->

  <!-- Permissions injectées par des dépendances transitives, sans usage dans l'app, retirées de la fusion.
       Laissées dans l'APK, elles imposeraient des déclarations Play Console (identifiant publicitaire,
       sécurité des données, permissions sensibles) sans fonctionnalité correspondante.
       - AD_ID / ACCESS_ADSERVICES_* : play-services-measurement (firebase_analytics, tiré par core_kosmos).
         Aucune régie publicitaire ni attribution.
       - CAMERA / RECORD_AUDIO : camera_android_camerax, tiré par le sélecteur de médias des paquets Kosmos
         (wechat_camera_picker), qu'aucun écran de Wina n'ouvre. L'écran de permissions ne demande que les
         notifications. USE_BIOMETRIC reste (local_auth, connexion biométrique). -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
  <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

  <!-- La bibliothèque caméra déclare android.hardware.camera.any sans required="false" : sans cette surcharge,
       le Play Store masquerait l'app sur tout appareil sans caméra. Les trois autres lignes indiquent que ni
       caméra, ni mise au point, ni micro ne sont requis. -->
  <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />

  <!-- Visibilité de paquets (Android 11+) : sans ces déclarations, la résolution
       d'intent échoue et url_launcher ne peut ouvrir ni les liens mailto
       (node "Aide") ni les liens https (réseaux sociaux). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <!-- allowBackup=false désactive la sauvegarde CLOUD d'Android (Auto Backup), qui copie les données
       privées de l'app, état d'authentification Firebase compris, vers Google Drive. Elle ne bloque pas
       forcément le transfert direct d'appareil à appareil sous Android 12+ (cela demande
       dataExtractionRules). Les données de Wina vivent dans Firestore : rien d'utile à sauvegarder. -->
   <application
        android:label="Wina"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Liens de l'app (App Links) : https://wina-c4c4a.web.app/share… ouvre l'app,
                 vérifiés par le fichier .well-known/assetlinks.json servi par la landing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wina-c4c4a.web.app" android:pathPrefix="/share" />
            </intent-filter>
            <!-- Un lien ouvre l'app sur son écran courant : le chemin du lien n'est pas transmis au
                 routeur Flutter, qui ne connaît aucune route /share. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
