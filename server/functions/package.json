{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only auth,firestore --project demo-wina \"vitest run\"",
    "test:watch": "firebase emulators:exec --only auth,firestore --project demo-wina \"vitest\"",
    "set-admin": "tsx scripts/set-admin.ts",
    "backfill-player-count": "tsx scripts/backfill-player-count.ts",
    "algolia-reindex": "tsx scripts/algolia-reindex.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "algoliasearch": "^5.60.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.2",
    "mailer-send-ts": "^1.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
